!.env.example
*.cache
# v0.2.5 local derived image copies; exported reports retain their manifests.
DetailPair_v0.2.5/runs/**/datasets/
# v0.2.6 local private copies and source-image visualizations stay on the execution machine.
DetailPair_v0.2.6/runs/**/datasets/
DetailPair_v0.2.6/runs/**/*.png
DetailPair_v0.2.6/runs/**/*.jpg
DetailPair_v0.2.6/runs/**/*.jpeg
DetailPair_v0.2.6/runs/**/*.npy

# v0.2.8 shared evaluation copies remain local; scalar manifests are tracked.
DetailPair_v0.2.8/runs/**/datasets/
DetailPair_v0.2.8/runs/**/*.png
DetailPair_v0.2.8/runs/**/*.jpg
DetailPair_v0.2.8/runs/**/*.npy

# BoxRoute runtime data and trained/private initialization remain local. Public fixed sources are explicit.
BoxRoute_v0.3.0/runs/**/private_data/
BoxRoute_v0.3.0/runs/**/datasets/
BoxRoute_v0.3.0/runs/**/*.pt
BoxRoute_v0.3.0/runs/**/*.pth
BoxRoute_v0.3.0/runs/**/*.png
BoxRoute_v0.3.0/runs/**/*.jpg
